modules = ["nodejs-20", "python-3.12", "web", "bash", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ZainJo Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ZainJo Frontend"

[[workflows.workflow]]
name = "ZainJo Backend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd zainjo-logstream/backend && CONFIG_PATH=../config.yaml SECRET_KEY=\"$SESSION_SECRET\" python -m uvicorn app.main:app --host 0.0.0.0 --port 8099 --loop uvloop"
waitForPort = 8099

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "ZainJo Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd zainjo-logstream/frontend && PORT=${PORT:-3000} BACKEND_PORT=8099 npm run dev"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["cargo", "libiconv", "libuv", "libxcrypt", "libyaml", "postgresql", "rustc"]
